# Core runtime
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4100
PUBLIC_API_URL=http://localhost:4100
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
EXPO_PUBLIC_API_URL=http://localhost:4100
EXPO_PUBLIC_WS_URL=ws://localhost:4100/v1/stream

# PostgreSQL 16 + pgvector
DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=orbit
S3_ACCESS_KEY=orbit
S3_SECRET_KEY=orbit-local-secret
S3_FORCE_PATH_STYLE=true

# Authentication. Replace these before any shared or production deployment.
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters-access
JWT_REFRESH_SECRET=change-me-to-at-least-32-characters-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_DELIVERY_MODE=log
ALLOW_DEVELOPMENT_OTP_DISPLAY=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=ORBIT <hello@example.com>
PHONE_OTP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Read-only Gmail OAuth. Keep disabled until the Google OAuth app and callback are verified.
GMAIL_INTEGRATION_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4100/v1/connections/gmail/callback
ORBIT_MOBILE_REDIRECT_URL=orbit://connections

# Optional public web search watcher provider (Brave-compatible by default).
SEARCH_API_ENDPOINT=https://api.search.brave.com/res/v1/web/search
SEARCH_API_KEY=

# Expo push requires the EAS project ID embedded into the native build.
EXPO_PUBLIC_EAS_PROJECT_ID=
# This is a public HTTPS URL compiled into the native app—never put API keys
# or other private values in any EXPO_PUBLIC_* variable.
# Local: http://<your-LAN-IP>:4100 ; staging/production: https://api.example.com
EXPO_PUBLIC_SENTRY_DSN=

# EAS build-only Sentry settings. Set them in EAS/Railway, not in a committed
# .env file. SENTRY_AUTH_TOKEN must have Sentry's org:ci scope.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Encryption for OAuth tokens and bring-your-own model keys.
# Generate 32 random bytes and encode as base64.
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
EXPORT_SIGNING_SECRET=change-me-export-signing-secret

# LLM providers. The built-in deterministic stub runs when keys are absent.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OpenRouter is supported for chat and embeddings. Set the provider to
# `openrouter` and use fully-qualified model names, for example
# `openai/gpt-4.1-mini`. No value in this template is a real credential.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=ORBIT
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_DEFAULT_PROVIDER=stub
LLM_MODEL_INTERVIEW=stub-interview-v1
LLM_MODEL_CONVERSATION=stub-conversation-v1
LLM_MODEL_RERANK=stub-rerank-v1
LLM_MODEL_JUDGE=stub-judge-v1
LLM_MODEL_DRAFT=stub-draft-v1
LLM_MODEL_REDACTION=stub-redaction-v1
LLM_MODEL_EMBEDDING=stub-embedding-v1
LLM_MODEL_SKILL_CRYSTALLIZATION=stub-skill-crystallization-v1
LLM_MODEL_SKILL_VALIDATION=stub-skill-validation-v1
LLM_MODEL_ASK_ROUTING=stub-ask-routing-v1
LLM_CHEAP_FALLBACK_MODEL=stub-fallback-v1
# Required when LLM_DEFAULT_PROVIDER is not `stub`. Values are cents, not dollars.
# These sample rates match gpt-5.6-luna's $0.20 input / $1.20 output per 1M tokens
# as checked on 2026-10-02. Override a task with, for example,
# LLM_COST_JUDGE_INPUT_CENTS_PER_MILLION_TOKENS and
# LLM_COST_JUDGE_OUTPUT_CENTS_PER_MILLION_TOKENS when it uses a different model.
LLM_INPUT_COST_CENTS_PER_MILLION_TOKENS=20
LLM_OUTPUT_COST_CENTS_PER_MILLION_TOKENS=120
# Optional tier routing. These values remain configuration-only and override
# legacy LLM_MODEL_* settings for the assigned task tier. Prices are cents/1M.
# Recheck the live OpenRouter catalog before production deployment.
LLM_TIER_CHEAP_PROVIDER=
LLM_TIER_CHEAP_PRIMARY_MODEL=
LLM_TIER_CHEAP_FALLBACK_PROVIDER=
LLM_TIER_CHEAP_FALLBACK_MODEL=
LLM_TIER_CHEAP_INPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_CHEAP_OUTPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_CHEAP_FALLBACK_INPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_CHEAP_FALLBACK_OUTPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_MID_PROVIDER=
LLM_TIER_MID_PRIMARY_MODEL=
LLM_TIER_MID_FALLBACK_PROVIDER=
LLM_TIER_MID_FALLBACK_MODEL=
LLM_TIER_MID_INPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_MID_OUTPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_MID_FALLBACK_INPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_MID_FALLBACK_OUTPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_STRONG_PROVIDER=
LLM_TIER_STRONG_PRIMARY_MODEL=
LLM_TIER_STRONG_FALLBACK_PROVIDER=
LLM_TIER_STRONG_FALLBACK_MODEL=
LLM_TIER_STRONG_INPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_STRONG_OUTPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_STRONG_FALLBACK_INPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TIER_STRONG_FALLBACK_OUTPUT_COST_CENTS_PER_MILLION_TOKENS=
LLM_TASK_REDACTION_TIER=CHEAP
LLM_TASK_EMBEDDING_TIER=CHEAP
LLM_TASK_ASK_ROUTING_TIER=CHEAP
LLM_TASK_INTERVIEW_TIER=MID
LLM_TASK_CONVERSATION_TIER=MID
LLM_TASK_RERANK_TIER=MID
LLM_TASK_SKILL_CRYSTALLIZATION_TIER=MID
LLM_TASK_SKILL_VALIDATION_TIER=MID
LLM_TASK_JUDGE_TIER=STRONG
LLM_TASK_DRAFT_TIER=STRONG
USER_DAILY_COST_CAP_CENTS=35
GLOBAL_DAILY_COST_CAP_CENTS=2500
MAX_CONVERSATION_TURNS=12
MAX_CONVERSATION_TOKENS=5000

# Safety / operations
INTRODUCTIONS_PER_USER_PER_DAY=12
DELETION_GRACE_DAYS=7
ADMIN_EMAILS=admin@example.com
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
ALLOW_DEVELOPMENT_SEED=true

# Worker schedules
NIGHTLY_MATCH_CRON=0 3 * * *
WATCHER_TICK_CRON=*/15 * * * *
CONSOLIDATION_CRON=30 4 * * *
DELETION_CRON=0 4 * * *
PUSH_TICK_CRON=* * * * *
PROACTIVE_TICK_CRON=15 * * * *
PROACTIVE_DAILY_CAP=6
# Optional comma-separated subset for a local one-shot worker run, e.g. proactive.
WORKER_ONCE_JOBS=
