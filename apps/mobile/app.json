{
  "expo": {
    "name": "ORBIT",
    "slug": "orbit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "orbit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/orbit-ring-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orbit.companion",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ORBIT uses the microphone only when you tap and hold to ask a question."
      }
    },
    "android": {
      "package": "com.orbit.companion",
      "versionCode": 1,
      "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/orbit-ring-icon.png",
        "backgroundColor": "#F7F5F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/orbit-ring-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
