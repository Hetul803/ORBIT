{
  "name": "@orbit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "pnpm --filter @orbit/shared build",
    "start": "expo start",
    "dev": "expo start",
    "preandroid": "pnpm --filter @orbit/shared build",
    "android": "expo run:android",
    "preios": "pnpm --filter @orbit/shared build",
    "ios": "expo run:ios",
    "preweb": "pnpm --filter @orbit/shared build",
    "web": "expo start --web",
    "prebuild": "pnpm --filter @orbit/shared build",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo-google-fonts/instrument-serif": "0.4.1",
    "@expo-google-fonts/martian-mono": "0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "5.104.0",
    "@orbit/shared": "workspace:*",
    "@orbit/ui": "workspace:*",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "5.0.2"
  }
}
