{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/Dockerfile.api",
    "watchPatterns": [
      "apps/api/**",
      "scripts/**",
      "packages/**",
      "infra/Dockerfile.api",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @orbit/db migrate:deploy",
    "startCommand": "pnpm --filter @orbit/api start",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
