{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "test:coverage": "turbo run test:coverage && node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @orbit/db generate",
    "db:migrate": "pnpm --filter @orbit/db migrate",
    "db:seed": "pnpm --filter @orbit/db seed",
    "api": "pnpm --filter @orbit/api dev",
    "worker": "pnpm --filter @orbit/worker dev",
    "worker:once": "pnpm --filter @orbit/worker once",
    "eval:reranker": "pnpm --filter @orbit/worker eval:reranker",
    "benchmark:retrieval": "pnpm --filter @orbit/worker benchmark:retrieval",
    "smoke:web-watcher": "pnpm --filter @orbit/worker smoke:web-watcher",
    "verify:export": "pnpm --filter @orbit/api verify:export",
    "secrets:generate": "node scripts/generate-production-secrets.mjs",
    "mobile": "pnpm --filter @orbit/mobile start",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sentry/cli": "2.58.4",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
