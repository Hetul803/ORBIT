{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ADMIN_EMAILS",
    "ALLOW_DEVELOPMENT_SEED",
    "ALLOWED_ORIGINS",
    "ANTHROPIC_API_KEY",
    "API_HOST",
    "API_PORT",
    "CONSOLIDATION_CRON",
    "DATABASE_URL",
    "DELETION_CRON",
    "DELETION_GRACE_DAYS",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_WS_URL",
    "EXPORT_SIGNING_SECRET",
    "FIELD_ENCRYPTION_KEY",
    "GLOBAL_DAILY_COST_CAP_CENTS",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "INTRODUCTIONS_PER_USER_PER_DAY",
    "JWT_ACCESS_SECRET",
    "JWT_ACCESS_TTL_SECONDS",
    "JWT_REFRESH_SECRET",
    "JWT_REFRESH_TTL_SECONDS",
    "LLM_DEFAULT_PROVIDER",
    "LLM_CHEAP_FALLBACK_MODEL",
    "LLM_MODEL_CONVERSATION",
    "LLM_MODEL_DRAFT",
    "LLM_MODEL_EMBEDDING",
    "LLM_MODEL_INTERVIEW",
    "LLM_MODEL_JUDGE",
    "LLM_MODEL_REDACTION",
    "LLM_MODEL_RERANK",
    "LOG_LEVEL",
    "MAX_CONVERSATION_TOKENS",
    "MAX_CONVERSATION_TURNS",
    "NIGHTLY_MATCH_CRON",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTP_DELIVERY_MODE",
    "OTP_TTL_SECONDS",
    "PHONE_OTP_API_KEY",
    "PHONE_OTP_PROVIDER",
    "PUBLIC_API_URL",
    "REDIS_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RUN_WORKER_ONCE",
    "S3_ACCESS_KEY",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_REGION",
    "S3_SECRET_KEY",
    "USER_DAILY_COST_CAP_CENTS",
    "WATCHER_TICK_CRON"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
